PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zmp_chat
HTTPS_ENABLED=true
HTTPS_PFX_PATH=../../certs/localhost-dev.pfx
HTTPS_PASSPHRASE=zmp-local-dev

# Zalo OAuth (https://developers.zalo.me/)
ZALO_APP_ID=
ZALO_APP_SECRET=
# Must exactly match the redirect URI registered in the Zalo console.
# Points at the SPA, which relays the code to /auth/zalo/callback.
ZALO_REDIRECT_URI=https://localhost:5173/auth/zalo/callback

# App JWT (issued to the SPA after Zalo callback)
# Generate locally: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
APP_JWT_SECRET=
APP_JWT_TTL_SECONDS=3600

# AES-256-GCM key for encrypting Zalo tokens at rest in the sessions table.
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Gemini-backed Tấm AI
GOOGLE_API_KEY=
AI_CHATBOT_NAME=Tấm AI
AI_CHATBOT_HANDLE=tam-ai
AI_CHATBOT_MODEL=gemini-2.5-flash-lite
AI_EMBEDDING_MODEL=gemini-embedding-2
AI_RAG_DOCUMENT_PATH=./storage/documents/Giai_Phap_Miniai_TamAI.pdf
AI_RAG_CHUNK_SIZE=1200
AI_RAG_CHUNK_OVERLAP=200
